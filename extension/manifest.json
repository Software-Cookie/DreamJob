{
  "manifest_version": 3,
  "name": "DreamJob Autofill",
  "version": "2.0.0",
  "description": "Fill job applications (Workday, Greenhouse, Lever, Ashby, SmartRecruiters and more) from your saved profile in one click.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "DreamJob Autofill",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.myworkdayjobs.com/*", "https://*.myworkdaysite.com/*", "https://*.workday.com/*",
    "https://boards.greenhouse.io/*", "https://job-boards.greenhouse.io/*", "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*", "https://jobs.smartrecruiters.com/*", "https://apply.workable.com/*",
    "https://*.icims.com/*", "https://*.taleo.net/*", "https://*.successfactors.com/*", "https://*.successfactors.eu/*",
    "https://*.recruitee.com/*", "https://*.breezy.hr/*", "https://*.jobs.personio.de/*", "https://*.bamboohr.com/*",
    "https://*.jobvite.com/*", "https://*.oraclecloud.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": [
        "https://*.myworkdayjobs.com/*", "https://*.myworkdaysite.com/*", "https://*.workday.com/*",
        "https://boards.greenhouse.io/*", "https://job-boards.greenhouse.io/*", "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*", "https://jobs.smartrecruiters.com/*", "https://apply.workable.com/*",
        "https://*.icims.com/*", "https://*.taleo.net/*", "https://*.successfactors.com/*", "https://*.successfactors.eu/*",
        "https://*.recruitee.com/*", "https://*.breezy.hr/*", "https://*.jobs.personio.de/*", "https://*.bamboohr.com/*",
        "https://*.jobvite.com/*", "https://*.oraclecloud.com/*"
      ],
      "js": ["filler.js", "runner.js", "content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "fill-form": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Fill this page from your DreamJob profile"
    }
  }
}
