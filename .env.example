# DreamJob settings. Every setting is optional.
# Local: copy to .env and export the values. Hosting: add them on your host's Variables/Secrets page.
# Keep comments on their own lines: some tools treat "KEY=value  # note" as part of the value.
# Never commit a real .env file (it is in .gitignore).

# ---- Optional job sources (free keys) ----------------------------------------------------------
# JSearch on RapidAPI: Google for Jobs results, which include LinkedIn, Indeed, Glassdoor, Naukri
# and company sites. Free plan is about 200 requests a month; results are cached for hours.
JSEARCH_API_KEY=
JSEARCH_CACHE_MINUTES=360
# Adzuna (developer.adzuna.com): on-site jobs in 19 countries.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# Jooble (jooble.org/api/about): large aggregator; the key is emailed to you.
JOOBLE_API_KEY=
JOOBLE_HOST=jooble.org
# Careerjet (careerjet.com/partners): free publisher key; aggregates Indian and global job sites.
CAREERJET_API_KEY=
CAREERJET_LOCALE=en_IN
# Deep search: searches per résumé on each portal (job titles, then top skills) and how long to wait.
DEEP_QUERIES=3
DEEP_SEARCH_TIMEOUT=20
# JSearch result pages per search (each extra page uses more of the free monthly quota).
JSEARCH_PAGES=1
# ISO country code and name used by keyed searches when Location is empty.
DEFAULT_COUNTRY=in
DEFAULT_COUNTRY_NAME=India

# ---- Index -------------------------------------------------------------------------------------
# Minutes between refreshes of job boards and of company career sites (app/companies.py).
REFRESH_MINUTES=30
BOARD_REFRESH_MINUTES=60
# New job descriptions fetched per company per refresh.
BOARD_DETAIL_LIMIT=150
# Extra SmartRecruiters country feeds.
BOARD_COUNTRIES=in
# Arbeitnow pages (300 jobs each, mostly Germany).
ARBEITNOW_PAGES=8
# Seconds a search waits for live results, and minutes they are cached.
LIVE_SEARCH_TIMEOUT=4
LIVE_CACHE_MINUTES=30

# ---- Limits ------------------------------------------------------------------------------------
MAX_UPLOAD_MB=5
# Searches per visitor per minute, per worker.
RATE_LIMIT_PER_MINUTE=30
TRUSTED_PROXY_HOPS=1
# Worker processes (use 1 on a 512 MB host).
WEB_CONCURRENCY=2

# ---- Payments: Razorpay (optional) -------------------------------------------------------------
# Leave both keys empty and DreamJob is completely free (no Pro, no payment buttons).
# Test keys start with rzp_test_, live keys with rzp_live_ (Dashboard > Account & Settings > API Keys).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when you add the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=
# Optional: any long random string. Signs Pro passes (otherwise derived from the key secret).
PASS_SECRET=
# Price in rupees (including GST if you charge it), how many days it lasts, and which sizes need Pro.
PRO_PRICE_INR=99
PRO_DAYS=30
PRO_TOPS=20,30

# ---- Sign-in (optional) -----------------------------------------------------------------------
# Long random string that signs sessions and sign-in links. Set it in production (same value on every restart);
# without it a random one is kept in data/auth_secret. Generate: python -c "import secrets;print(secrets.token_hex(32))"
AUTH_SECRET=
# 1 = visitors must sign in before searching. Empty = sign-in is optional.
AUTH_REQUIRED=
# Google: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorised redirect URI: <SITE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email sign-in links. Gmail: smtp.gmail.com, port 587, your address, and a 16-character App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The sender shown to users, for example: DreamJob <you@gmail.com>
SMTP_FROM=
# auto (port 465 = TLS, other ports = STARTTLS). "none" only for a local test mail server.
SMTP_TLS=auto

# ---- Business details (shown on the Terms, Privacy, Refunds and Contact pages) ------------------
BUSINESS_NAME=DreamJob
# Support email shown to customers. Set it before you take payments.
CONTACT_EMAIL=
# City and state is enough for an individual.
BUSINESS_ADDRESS=
# Public address of the site, for example https://your-space.hf.space
SITE_URL=
