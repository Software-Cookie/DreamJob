# All settings are optional. Copy to .env (local) or add them in your host's "Variables/Secrets" page.

# ---- Optional sources (free keys) ------------------------------------------------------------
# JSearch on RapidAPI: Google for Jobs results, which include LinkedIn, Indeed, Glassdoor, Naukri
# and company sites. Free plan is about 200 requests a month; results are cached for hours.
JSEARCH_API_KEY=
JSEARCH_CACHE_MINUTES=360
# Adzuna (developer.adzuna.com): on-site jobs in 19 countries.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# Jooble (jooble.org/api/about): large aggregator; the key is emailed to you.
JOOBLE_API_KEY=
JOOBLE_HOST=jooble.org

DEFAULT_COUNTRY=in              # ISO code used by keyed searches
DEFAULT_COUNTRY_NAME=India      # used when the user leaves Location empty

# ---- Index -----------------------------------------------------------------------------------
REFRESH_MINUTES=30              # job boards
BOARD_REFRESH_MINUTES=60        # company career sites (app/companies.py)
BOARD_DETAIL_LIMIT=150          # new job descriptions fetched per company per refresh
BOARD_COUNTRIES=in              # extra SmartRecruiters country feeds
ARBEITNOW_PAGES=8               # 300 jobs per page (mostly Germany)
LIVE_SEARCH_TIMEOUT=4           # seconds a search waits for live results
LIVE_CACHE_MINUTES=30

# ---- Limits ----------------------------------------------------------------------------------
MAX_UPLOAD_MB=5
RATE_LIMIT_PER_MINUTE=30        # searches per visitor per minute, per worker
TRUSTED_PROXY_HOPS=1
WEB_CONCURRENCY=2               # worker processes (1 on a 512 MB host)
